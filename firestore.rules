rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: admins
// Document ID: Firebase Authentication UID
// Fields:
//   - email: string
//   - displayName: string
//   - role: "owner" | "admin"
//   - createdAt: timestamp
// There is no client bootstrap. A non-admin cannot create admins/{uid}.
//
// Collection: tours
// Fields: title, slug, description, duration, price, travelStyleId, destinations,
//   accommodationIds, tagIds, itinerary, included, excluded, images, featured, popular, published,
//   pricingBasis ("per_person" | "for_2" | "for_4" | "custom"), pricingCustomLabel,
//   createdAt, updatedAt
// itinerary[].locations items are { name: string, destinationId?: string }.
// Legacy itinerary locations stored as string[] are still read by the client.
// Public read requires published == true.
//
// Collection: travelStyles
// Fields: name, slug, createdAt, updatedAt
// Public read is required so published tours can show the travel style name.
// Writes are admin-only.
//
// Collection: tags
// Fields: name, slug, createdAt, updatedAt
// Public read is required so published tours can show their tag names.
// Writes are admin-only. Documents contain only the label.
//
// Collection: accommodations
// Fields: name, description, type, location, images, published,
//   createdAt, updatedAt
// Public read requires published == true.
//
// Collection: whyTravelerItems
// Fields: title, description, icon, published, order, createdAt, updatedAt
// Public read requires published == true. Writes are admin-only.
//
// Collection: contactFaqs
// Fields: question, answer, published, order, createdAt, updatedAt
// Public read requires published == true. Writes are admin-only.
//
// Collection: heroBenefits
// Fields: title, description, icon (approved identifier), order, published,
//   createdAt, updatedAt
// Public read requires published == true. Writes are admin-only.
// The six-item limit is enforced by the admin service.
//
// Collection: destinations
// Fields: name, slug, subtitle, description, coverImage (hero image),
//   glance { bestTimeMonths { startMonth, endMonth }, province, district,
//   recommendedStay { unit, value }, characteristics, characteristicOther,
//   idealFor }, essenceThemes, overviewTitle, overviewDescription (Markdown),
//   keyHighlights [{ id, title, detail, icon, published }],
//   experiences [{ id, title, description, image, published }], thingsToDo,
//   placesToVisit, bestTime, travelInfo, gallery, relatedTours, featured,
//   popular, published, availableForInquiry, createdAt, updatedAt
// Missing featured, popular, and published are treated as false by the client.
// Public read requires published == true.
//
// Collection: audienceCategories
// Document ID: URI-encoded, lower-cased "Ideal for" label
// Fields: name, createdAt
// Admin-only. Destinations store the selected labels, so public pages never read this.
//
// Collection: vehicles
// Fields: name, type, description, passengerCapacity, luggageCapacity,
//   airConditioning, features, images, published, createdAt, updatedAt
// Public read requires published == true.
//
// Collection: reviews
// Fields: reviewerName, tourId, destinationIds, rating (1-5, whole or half),
//   reviewText, retained, createdAt, updatedAt, status
//   ("pending" | "approved" | "rejected"), publishedAt
// New public submissions write status == "approved" and are visible immediately.
// Legacy documents may still have travelerName, email, country, review, photo,
//   travelDate, and featured. Public read still requires status == "approved".
// Destination and tour names are resolved from those collections, not stored here.
//
// Collection: adminNotifications
// Document ID: "review_" + reviewId (prevents duplicate review notifications)
// Fields: title ("New Review Submitted"), description, reviewId, type ("review"),
//   read (bool), createdAt
// Public create is allowed only in the same write as a new review, with a fixed
//   title/type and a description derived from that review. No public read.
// Only admins may read, mark read, or delete notification documents.
//
// Collection: gallery
// Fields: imageUrl, publicId, title, optional tourId, optional destinationId,
//   caption, altText, published, createdAt, updatedAt
// Older documents may have category and omit title, tourId, destinationId, or updatedAt.
// Title falls back to caption or altText. Public read requires published == true.
// Tour gallery extras also live on tours.images after the hero image.
// Destination gallery images live on destinations.gallery. Each tour or destination
// may have at most two associated gallery images across both stores.
//
// Collection: inquiries
// Fields: type ("package_tour" | "custom_tour" | "general"), name, email,
//   phone, optional travelDate, returnDate, estimatedTravelDays (inclusive
//   calendar days), optional travel fields, message, status
//   ("New" | "Contacted" | "Follow-up" | "Converted" | "Closed"),
//   createdAt, updatedAt
// Public create requires status == "New". No public read, update, or delete.
// Older documents may omit estimatedTravelDays.
//
// Collection: siteSettings
// Singleton website settings: logo, phone, whatsapp, email, address,
//   socialLinks, heroText, footer
// Document siteSettings/heroBenefits: mobileAutoScrollSpeed (1-10), initialized,
//   updatedAt
// Document siteSettings/about: About Us page settings (hero, distinction, origins,
//   journeyBaseline, distinctionFacts, approachesInitialized)
// Subcollection siteSettings/about/teamMembers: name, image, designation,
//   description, order, published, createdAt, updatedAt
//   Public read requires published == true. Writes are admin-only.
// Subcollection siteSettings/about/approaches: title, description, order, deleted,
//   createdAt, updatedAt
//   Public read requires deleted == false. Writes are admin-only.
//   Approaches are soft-deleted; documents are never permanently removed by the CMS.
// Why Travelers content stays in whyTravelerItems and is not duplicated here.
// Public read of siteSettings documents is intentional. Writes are admin-only.
//
// Admin CMS writes are authorized by role and are not field-validated here.
// Anonymous creates are limited to the known fields and the status rules above.
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function adminPath() {
      return /databases/$(database)/documents/admins/$(request.auth.uid);
    }

    function isAdmin() {
      return isAuthenticated()
        && exists(adminPath())
        && get(adminPath()).data.role in ['owner', 'admin'];
    }

    function isPublished() {
      return resource.data.published == true;
    }

    function boundedString(value, maxLen) {
      return value is string && value.size() <= maxLen;
    }

    function optionalBoundedString(data, field, maxLen) {
      return !(field in data) || boundedString(data[field], maxLen);
    }

    function boundedList(value, maxSize) {
      return value is list && value.size() <= maxSize;
    }

    function optionalBoundedList(data, field, maxSize) {
      return !(field in data) || boundedList(data[field], maxSize);
    }

    function optionalIntInRange(data, field, minValue, maxValue) {
      return !(field in data)
        || (data[field] is int && data[field] >= minValue && data[field] <= maxValue);
    }

    function isMediaAsset(value) {
      return value is map
        && value.keys().hasOnly(['imageUrl', 'publicId', 'altText', 'caption'])
        && value.keys().hasAll(['imageUrl', 'publicId', 'altText'])
        && boundedString(value.imageUrl, 2000)
        && boundedString(value.publicId, 500)
        && boundedString(value.altText, 300)
        && (!('caption' in value) || boundedString(value.caption, 500));
    }

    function isValidPublicInquiry(data) {
      return data.keys().hasOnly([
          'type',
          'name',
          'email',
          'phone',
          'travelDate',
          'returnDate',
          'estimatedTravelDays',
          'travellers',
          'adults',
          'children',
          'country',
          'tourId',
          'destinations',
          'destinationIds',
          'otherDestination',
          'interests',
          'budget',
          'accommodation',
          'vehiclePreference',
          'message',
          'status',
          'createdAt',
          'updatedAt',
        ])
        && data.keys().hasAll([
          'type',
          'name',
          'email',
          'phone',
          'message',
          'status',
          'createdAt',
          'updatedAt',
        ])
        && data.type in ['package_tour', 'custom_tour', 'general']
        && data.status == 'New'
        && boundedString(data.name, 200)
        && data.name.size() > 0
        && boundedString(data.email, 320)
        && data.email.size() > 0
        && boundedString(data.phone, 40)
        && data.phone.size() > 0
        && boundedString(data.message, 4000)
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && optionalBoundedString(data, 'travelDate', 40)
        && optionalBoundedString(data, 'returnDate', 40)
        && optionalIntInRange(data, 'estimatedTravelDays', 1, 400)
        && optionalBoundedString(data, 'country', 100)
        && optionalBoundedString(data, 'tourId', 128)
        && optionalBoundedString(data, 'otherDestination', 200)
        && optionalBoundedString(data, 'budget', 100)
        && optionalBoundedString(data, 'accommodation', 200)
        && optionalBoundedString(data, 'vehiclePreference', 200)
        && optionalIntInRange(data, 'travellers', 1, 100)
        && optionalIntInRange(data, 'adults', 0, 100)
        && optionalIntInRange(data, 'children', 0, 100)
        && optionalBoundedList(data, 'destinations', 40)
        && optionalBoundedList(data, 'destinationIds', 40)
        && optionalBoundedList(data, 'interests', 40);
    }

    function isBoundedId(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }

    function isBoundedIdList(value, maxItems, maxLen) {
      return value is list
        && value.size() <= maxItems
        && (value.size() < 1 || isBoundedId(value[0], maxLen))
        && (value.size() < 2 || isBoundedId(value[1], maxLen))
        && (value.size() < 3 || isBoundedId(value[2], maxLen))
        && (value.size() < 4 || isBoundedId(value[3], maxLen))
        && (value.size() < 5 || isBoundedId(value[4], maxLen))
        && (value.size() < 6 || isBoundedId(value[5], maxLen))
        && (value.size() < 7 || isBoundedId(value[6], maxLen))
        && (value.size() < 8 || isBoundedId(value[7], maxLen))
        && (value.size() < 9 || isBoundedId(value[8], maxLen))
        && (value.size() < 10 || isBoundedId(value[9], maxLen))
        && (value.size() < 11 || isBoundedId(value[10], maxLen))
        && (value.size() < 12 || isBoundedId(value[11], maxLen));
    }

    function isValidReviewRating(value) {
      return value is number
        && value >= 1
        && value <= 5
        && value * 2 == int(value * 2);
    }

    function isPublishedTour(tourId) {
      return tourId is string
        && tourId.size() > 0
        && tourId.size() <= 128
        && get(/databases/$(database)/documents/tours/$(tourId)).data.published == true;
    }

    function reviewNotificationId(reviewId) {
      return 'review_' + reviewId;
    }

    function isValidPublicReview(data) {
      return data.keys().hasOnly([
          'reviewerName',
          'tourId',
          'destinationIds',
          'rating',
          'reviewText',
          'retained',
          'status',
          'publishedAt',
          'createdAt',
          'updatedAt',
        ])
        && data.keys().hasAll([
          'reviewerName',
          'tourId',
          'destinationIds',
          'rating',
          'reviewText',
          'retained',
          'status',
          'publishedAt',
          'createdAt',
          'updatedAt',
        ])
        && data.status == 'approved'
        && data.retained == false
        && data.publishedAt == request.time
        && boundedString(data.reviewerName, 200)
        && data.reviewerName.size() > 0
        && boundedString(data.reviewText, 5000)
        && data.reviewText.size() > 0
        && isPublishedTour(data.tourId)
        && isValidReviewRating(data.rating)
        && isBoundedIdList(data.destinationIds, 12, 128)
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidPublicReviewNotification(data, notificationId) {
      return data.keys().hasOnly([
          'title',
          'description',
          'reviewId',
          'type',
          'read',
          'createdAt',
        ])
        && data.keys().hasAll([
          'title',
          'description',
          'reviewId',
          'type',
          'read',
          'createdAt',
        ])
        && data.title == 'New Review Submitted'
        && data.type == 'review'
        && data.read == false
        && boundedString(data.reviewId, 128)
        && data.reviewId.size() > 0
        && notificationId == reviewNotificationId(data.reviewId)
        && boundedString(data.description, 280)
        && data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/reviews/$(data.reviewId))
        && getAfter(/databases/$(database)/documents/reviews/$(data.reviewId)).data.createdAt == request.time
        && data.description == getAfter(/databases/$(database)/documents/reviews/$(data.reviewId)).data.reviewerName + ' submitted a new review.';
    }

    function isValidNotificationReadUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool
        && request.resource.data.read == true;
    }

    // Denied for everyone who is not already an owner or admin.
    // Creating admins/{request.auth.uid} does not satisfy isAdmin().
    match /admins/{uid} {
      allow read, write: if isAdmin();
    }

    match /tours/{tourId} {
      allow read: if isAdmin() || isPublished();
      allow write: if isAdmin();
    }

    match /destinations/{destinationId} {
      allow read: if isAdmin() || isPublished();
      allow write: if isAdmin();
    }

    match /audienceCategories/{categoryId} {
      allow read, write: if isAdmin();
    }

    match /accommodations/{accommodationId} {
      allow read: if isAdmin() || isPublished();
      allow write: if isAdmin();
    }

    match /whyTravelerItems/{itemId} {
      allow read: if isAdmin() || isPublished();
      allow write: if isAdmin();
    }

    match /contactFaqs/{faqId} {
      allow read: if isAdmin() || isPublished();
      allow write: if isAdmin();
    }

    match /heroBenefits/{benefitId} {
      allow read: if isAdmin() || isPublished();
      allow write: if isAdmin();
    }

    match /tags/{tagId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /travelStyles/{travelStyleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /vehicles/{vehicleId} {
      allow read: if isAdmin() || isPublished();
      allow write: if isAdmin();
    }

    match /gallery/{galleryId} {
      allow read: if isAdmin() || isPublished();
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if isAdmin() || resource.data.status == 'approved';
      allow create: if isAdmin() || (
        isValidPublicReview(request.resource.data)
        && existsAfter(/databases/$(database)/documents/adminNotifications/$(reviewNotificationId(reviewId)))
      );
      allow update, delete: if isAdmin();
    }

    match /adminNotifications/{notificationId} {
      allow read, delete: if isAdmin();
      allow create: if isValidPublicReviewNotification(request.resource.data, notificationId);
      allow update: if isAdmin() && isValidNotificationReadUpdate();
    }

    match /inquiries/{inquiryId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || isValidPublicInquiry(request.resource.data);
    }

    match /siteSettings/{documentId} {
      allow read: if true;
      allow write: if isAdmin();

      match /teamMembers/{memberId} {
        allow read: if isAdmin() || isPublished();
        allow write: if isAdmin();
      }

      match /approaches/{approachId} {
        allow read: if isAdmin() || resource.data.deleted == false;
        allow write: if isAdmin();
      }
    }
  }
}
